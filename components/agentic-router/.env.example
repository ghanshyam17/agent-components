# Lower (small / fast) vLLM instance — OpenAI-compatible endpoint
LOWER_VLLM_BASE_URL=http://localhost:8001/v1
LOWER_MODEL=qwen2.5-1.5b-instruct

# Higher (large / capable) vLLM instance — OpenAI-compatible endpoint
HIGHER_VLLM_BASE_URL=http://localhost:8002/v1
HIGHER_MODEL=qwen2.5-32b-instruct

# API key your vLLM servers expect (use "EMPTY" if vLLM runs without auth)
VLLM_API_KEY=EMPTY

# Routing thresholds (calibrated to the heuristic score distribution)
ROUTER_LOWER_THRESHOLD=0.15
ROUTER_HIGHER_THRESHOLD=0.45
# A score within this band of either threshold is also sent to the classifier
ROUTER_CLASSIFIER_BAND=0.05

# Agentic loop limits
AGENT_MAX_ITERATIONS=8
AGENT_MAX_PLAN_SUBTASKS=5
AGENT_ENABLE_PLANNING=true
AGENT_ENABLE_TOOLS=true

# Server
HOST=0.0.0.0
PORT=8000